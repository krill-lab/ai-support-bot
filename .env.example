# SB_OPENAI_API_KEY=
SB_KB_FILE=examples/kb.jsonl
SB_POLICY_FILE=examples/policy.txt
SB_TOOLS=examples/demo_tools.py
SB_DB=demo.sqlite
SB_TZ_OFFSET_HOURS=0
SB_AUTO_SEND=0
